# Copy to .env on your EC2 instance and fill in values
# cp .env.aws.template .env

# RDS endpoint (from AWS Console → RDS → your instance → Endpoint)
RDS_HOST=your-rds-instance.xxxx.eu-west-1.rds.amazonaws.com

# Database credentials (set when creating RDS instance)
DB_USER=traffic_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=traffic_service

# JWT secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# RabbitMQ credentials
RABBITMQ_USER=traffic
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD

# Your EC2 public IP (used by frontend to reach the API)
EC2_PUBLIC_IP=1.2.3.4
