# VM2 — eu-west-2 (London)
# Copy to .env on VM2:  cp .env.vm2.template .env

# RDS endpoint for UK DB (eu-west-2)
RDS_HOST=traffic-uk.xxxx.eu-west-2.rds.amazonaws.com

DB_USER=traffic_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=traffic_service

# JWT — must be IDENTICAL to VM1
JWT_SECRET=CHANGE_ME_SAME_ON_BOTH_VMS

RABBITMQ_USER=traffic
RABBITMQ_PASSWORD=CHANGE_ME

# This VM owns UK + France bookings (comma-separated)
LOCAL_REGION=EU_WEST_UK,EU_WEST_FRANCE

# Point back to VM1's booking service
PEER_BOOKING_URL=http://VM1_PUBLIC_IP:8002

EC2_PUBLIC_IP=VM2_PUBLIC_IP