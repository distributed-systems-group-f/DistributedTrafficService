# VM1 — eu-west-1 (Ireland)
# Copy to .env on VM1:  cp .env.vm1.template .env

# RDS endpoint for Ireland DB (eu-west-1)
RDS_HOST=traffic-ireland.xxxx.eu-west-1.rds.amazonaws.com

DB_USER=traffic_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=traffic_service

# JWT — generate with: openssl rand -hex 32
# Must be IDENTICAL on both VMs (tokens issued by VM1 must be accepted by VM2)
JWT_SECRET=CHANGE_ME_SAME_ON_BOTH_VMS

RABBITMQ_USER=traffic
RABBITMQ_PASSWORD=CHANGE_ME

# This VM owns Ireland bookings
LOCAL_REGION=EU_WEST_IRELAND

# Point to VM2's booking service (fill in VM2's public IP after launching it)
PEER_BOOKING_URL=http://VM2_PUBLIC_IP:8002

EC2_PUBLIC_IP=VM1_PUBLIC_IP
